# Scratch userData for `npm run dev:isolated` — never the real catalog.
.dev-userdata/

# Scratch TMPDIR for electron-builder. The deb target stages the whole package through
# TMPDIR before piping it to tar, which fails on a small or quota-limited /tmp.
.build-tmp/

# Local, per-machine list of strings that must never reach a built artifact.
# See scripts/check-artifact-identity.sh.
.identity-forbidden

# Local working notes and the build history, kept out of the public repo.
notes

# Local guidance for coding agents. Kept out of the public repo on purpose.
CLAUDE.md
